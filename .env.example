ACM_MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# For another OpenAI-compatible provider, set ACM_MODEL_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Local mode is for trusted code. Docker requires a running daemon.
ACM_EXECUTOR=local
ACM_CXX=g++
ACM_CC=gcc
# ACM_PYTHON defaults to the Python interpreter running ACM Agent.
ACM_PYTHON=
ACM_JAVAC=javac
ACM_JAVA=java
ACM_COMPILE_TIMEOUT_MS=10000
ACM_RUN_TIMEOUT_MS=2000
ACM_DATABASE=workspace/acm_agent.sqlite3
ACM_DOCKER_IMAGE=acm-agent-runtime:latest
ACM_DOCKER_WORKERS=2
ACM_DOCKER_MEMORY=512m
ACM_DOCKER_CPUS=1.0
ACM_DOCKER_NETWORK=false
